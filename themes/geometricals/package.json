{
  "name": "@peacock0803sz/theme-geometricals",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peacock0803sz/slidev-themes.git",
    "directory": "themes/geometricals"
  },
  "engines": {
    "node": ">=24.22.3",
    "slidev": ">=0.19.2"
  },
  "scripts": {
    "dev": "slidev example.md",
    "format": "slidev format"
  },
  "publishConfig": {
    "@peacock0803sz:registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "slidev": {
    "colorSchema": "light",
    "highlighter": "shiki",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 960,
      "presenter": "dev",
      "fonts": {
        "mono": "JetBrains Mono",
        "sans": "Avenir Next,Murecho,IBM Plex Sans JP",
        "local": "Avenir Next"
      }
    }
  },
  "dependencies": {
    "@slidev/types": "^53.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "shiki": "^4.5.0"
  }
}
