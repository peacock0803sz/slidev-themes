{
  "name": "@peacock0803sz/theme-riso",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peacock0803sz/slidev-themes.git",
    "directory": "themes/riso"
  },
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=24.22.3",
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "dev": "slidev example.md",
    "format": "slidev format example.md"
  },
  "publishConfig": {
    "@peacock0803sz:registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@slidev/cli": "^52.20.1",
    "@slidev/types": "^52.20.1",
    "markdown-it": "^14.3.3"
  },
  "slidev": {
    "colorSchema": "light",
    "highlighter": "shiki",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "codeCopy": false,
      "transition": "riso-register",
      "fonts": {
        "sans": "BIZ UDPGothic",
        "mono": "JetBrains Mono",
        "provider": "none"
      }
    }
  }
}
