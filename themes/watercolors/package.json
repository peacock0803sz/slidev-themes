{
  "name": "@peacock0803sz/theme-watercolors",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peacock0803sz/slidev-themes.git",
    "directory": "themes/watercolors"
  },
  "engines": {
    "node": ">=24.22.3",
    "slidev": ">=0.19.2"
  },
  "publishConfig": {
    "@peacock0803sz:registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "slidev": {
    "colorSchema": "light",
    "highlighter": "shiki",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 960,
      "fonts": {
        "mono": "JetBrains Mono",
        "sans": "Avenir Next,Nunito Sans",
        "local": "Avenir Next"
      }
    }
  },
  "dependencies": {
    "@slidev/types": "^53.0.0",
    "codemirror-theme-vars": "^0.1.2",
    "prism-theme-vars": "^0.2.5",
    "theme-vitesse": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
